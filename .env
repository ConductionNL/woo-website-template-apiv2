##################################################

# Application settings

##################################################

# This section contains generic settings for your application

# The shortcode for this component, should be a small set of letters reprecentint the application (use only letters, capitals and spaces)

APP_NAME=woo-website
APP_NAME_TECHNCICAL=woo-website

# The description for this api

APP_DESCRIPTION=woo-website

# NOT a version source — versions come from git tags created by
# semantic-release (.github/workflows/release.yml). Kept only because the
# disabled Codeberg release job (.forgejo/workflows/dockerimage.yml) reads
# it; remove together with that job.

APP_VERSION=V1.0
APP_MAJOR_VERSION=v1

# The type either application or component

APP_TYPE=component

# Gatsby build-time (bron van waarheid)
GATSBY_ENV_VARS_SET=true
GATSBY_DEV_ENVIRONMENT=false
GATSBY_API_BASE_URL=/api

# Thema + organisatie + branding
GATSBY_NL_DESIGN_THEME_CLASSNAME=conduction-theme
GATSBY_ORGANISATION_NAME=Conduction
GATSBY_JUMBOTRON_IMAGE_URL="https://raw.githubusercontent.com/ConductionNL/woo-website-conduction/main/cropped-Conduction_HOME_0000_afb1-1.png"
# Jumbotron card texts; {ORGANISATION_NAME} is replaced with GATSBY_ORGANISATION_NAME.
# Empty = translated default: "Woo-publicaties van {ORGANISATION_NAME}" /
# "Op deze pagina vindt u de Woo-publicaties van {ORGANISATION_NAME}"
# NB configured texts are NOT translated by the language switch — on audited
# deployments combine with GATSBY_HIDE_LANGUAGE_SWITCH=true (WCAG 3.1.2)
GATSBY_JUMBOTRON_TITLE=
GATSBY_JUMBOTRON_SUBTITLE=
GATSBY_FAVICON_URL="data:image/svg+xml,%3Csvg id='Laag_1' data-name='Laag 1' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 259.81 300'%3E%3Cpath d='M129.9,0,0,75V225l129.9,75,129.91-75V75Zm96.8,205.89-96.8,55.88L33.1,205.89V94.11l96.8-55.89,96.8,55.89Z' style='fill:%234376fc'/%3E%3Cpolygon points='129.59 112.23 160.01 129.79 195.41 109.35 129.59 71.35 61.47 110.67 61.47 189.33 129.59 228.65 195.41 190.65 160.01 170.21 129.59 187.77 96.88 168.88 96.88 131.12 129.59 112.23' style='fill:%234376fc'/%3E%3C/svg%3E"

# Footer
GATSBY_FOOTER_LOGO_URL=https://conduction.nl
GATSBY_FOOTER_LOGO_HREF=https://conduction.nl/
GATSBY_FOOTER_CONTENT=
GATSBY_FOOTER_CONTENT_HEADER=heading-4
GATSBY_FOOTER_HIDE_LOVE=
GATSBY_FOOTER_HIDE_LOGO=

# Optioneel (features/analytics)
GATSBY_SHOW_THEME_SWITCHER=false
GATSBY_SHOW_CATEGORY=true
GATSBY_SHOW_ORGANIZATION=
# options: "buttons" | "scrollbar" — scrollbar shows the native scrollbar (WCAG 1.4.10), buttons (default) uses custom scroll buttons
GATSBY_TABLE_SCROLL_MODE=""
# "true" hides the NL/EN language switch — untranslated Dutch API content cannot carry a correct lang attribute, so an all-Dutch page satisfies WCAG 3.1.2
GATSBY_HIDE_LANGUAGE_SWITCH=
# "true" replaces the whole site with the maintenance screen and closes the /api/ proxy (nginx answers 503; runtime container var).
# The screen shows Dutch first, then English; the _NL / _EN titles and messages replace the default texts per language (plain text). Details: docs/techniek/Onderhoud.md
# In a container the unprefixed MAINTENANCE_* names work too and win (use those on the platform).
GATSBY_MAINTENANCE_MODE=
GATSBY_MAINTENANCE_TITLE_NL=
GATSBY_MAINTENANCE_MESSAGE_NL=
GATSBY_MAINTENANCE_TITLE_EN=
GATSBY_MAINTENANCE_MESSAGE_EN=
# Allowed iframe ancestors (CSP frame-ancestors, runtime container var — not a build arg).
# Default 'none' (embedding blocked). Portal embedding example: 'self' https://portal.gemeente.nl
FRAME_ANCESTORS=
GATSBY_OIDN_NUMBER=00000001809245206000
GATSBY_ANALYTICS_URL=
GATSBY_DATE_FULL_MONTH=false

# Optioneel (CSP overrides)
GATSBY_CSP_CONNECT_SRC_FULL=
GATSBY_CSP_CONNECT_SRC_EXTRA=

# Dev-proxy (alleen voor `npm run dev`)
DEV_PROXY_TARGET=https://zuiddrecht-drie.accept.commonground.nu/apps/opencatalogi/api

# Docker image tag/registry (Compose)
CONTAINER_REGISTRY_BASE=ghcr.io/conductionnl
CONTAINER_PROJECT_NAME=woo-website-v2
APP_BUILD=helm

# NGINX runtime proxy (Compose)
UPSTREAM_HOST=zuiddrecht-drie.accept.commonground.nu
UPSTREAM_BASE=https://zuiddrecht-drie.accept.commonground.nu/apps/opencatalogi/api

# Security.txt https://www.gatsbyjs.com/plugins/gatsby-plugin-security-txt/
GATSBY_SECURITY_TXT_INTRO=Information related to reporting security vulnerabilities of this site.
GATSBY_SECURITY_TXT_CONTACT=mailto:info@conduction.nl
GATSBY_SECURITY_TXT_EXPIRES=2026-12-31T23:00:00.000Z
GATSBY_SECURITY_TXT_ENCRYPTION=
GATSBY_SECURITY_TXT_ACKNOWLEDGEMENTS=
GATSBY_SECURITY_TXT_LANGUAGES=nl, en
GATSBY_SECURITY_TXT_CANONICAL=
GATSBY_SECURITY_TXT_POLICY=
GATSBY_SECURITY_TXT_HIRING=
